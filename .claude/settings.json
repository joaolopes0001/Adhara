{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm test)",
      "Bash(npm run test:ui)",
      "Bash(npm run test:ui *)",
      "Bash(npm run test:audit)",
      "Bash(python3 -m unittest discover -s tests -t . *)",
      "Bash(python3 scripts/aae.py audit *)",
      "Bash(python3 scripts/aae.py inventory *)",
      "Bash(python3 scripts/aae.py schema *)",
      "Bash(python3 scripts/aae.py protected)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git remote *)",
      "Bash(python3 scripts/install.py *)"
    ],
    "deny": [
      "Edit(/dist/**)",
      "Read(/.env)",
      "Read(/.env.*)"
    ]
  }
}
